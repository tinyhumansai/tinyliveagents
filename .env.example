# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
# Only the live tests and examples in `crates/tinyliveagents-examples` read
# these; the library takes credentials as constructor arguments and the
# offline test suite needs none of them. Every live test skips when its key is
# unset.

# Sarvam AI subscription key: the Sarvam cascade live test and example, and the
# REST TTS used to synthesize the spoken test question.
# SARVAM_API_KEY=replace-me

# Google AI Studio key for the direct Gemini Live test and example.
# GEMINI_API_KEY=replace-me
# Optional Live model override (defaults to tinyliveagents::gemini::DEFAULT_MODEL).
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# TinyHumans backend API key and base URL, for the relayed Gemini Live and
# ElevenLabs examples (they mint a ticket / signed URL first).
# TINYHUMANS_API_KEY=replace-me
# TINYHUMANS_BASE_URL=https://api.tinyhumans.ai

# A 16 kHz PCM16 mono WAV to speak instead of synthesizing the question.
# LIVE_TEST_WAV=/path/to/question.wav

# Log filter, for hosts that install a tracing subscriber.
# RUST_LOG=tinyliveagents=debug
